DATABASE_URL="postgresql://postgres:postgres@localhost:5432/danofunmi_dev"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
# One origin, or a comma-separated list (e.g. for a bare + www domain, or
# staging alongside production): "https://danofunmi.com,https://www.danofunmi.com"
FRONTEND_ORIGIN="http://localhost:5173"

# This backend's own public origin — different from FRONTEND_ORIGIN (see
# idea_pad/deploy.sh's nginx config: the frontend and API live on different
# domains, e.g. danofunmi.com vs api.danofunmi.com). Used to build absolute
# /uploads/... URLs for images embedded in outgoing email (see
# lib/email.js's apiOrigin()) — a bare path won't resolve in someone's
# inbox. Falls back to http://localhost:$PORT if unset.
PUBLIC_API_ORIGIN="http://localhost:4000"

# Bank account customers pay into. Shown on the order confirmation screen
# alongside the auto-generated narration.
BANK_NAME="Example Bank"
BANK_ACCOUNT_NAME="Danofunmi Foods"
BANK_ACCOUNT_NUMBER="0000000000"

# Largest payment receipt photo customers may upload (POST
# /api/orders/:id/receipt), in KB. Enforced by multer
# (backend/src/lib/uploads.js) and echoed to the frontend via GET
# /api/payment-info so the upload form can show the limit and reject an
# oversized file before it's even sent.
RECEIPT_MAX_FILE_SIZE_KB=15360

# Shared secret used by the whatsapp-bot service to call internal admin-only
# endpoints (creating orders on a customer's behalf, attaching receipts).
INTERNAL_API_KEY="change-this-too"

# Comma-separated list of emails to alert on a crash/error/bug — a server
# error, or the AI chat failing/running out of Anthropic credit (see
# lib/email.js's sendAdminAlertEmail, lib/errorLog.js, routes/chat.js).
# Deliberately separate from any AdminUser login: whoever should actually
# get paged doesn't have to have an admin account. Requires ZOHO_API_KEY
# below to be set too — otherwise alerts are logged (console + the admin
# "Error logs" page) but not emailed. Leave unset to disable email alerts
# entirely.
ADMIN_EMAILS=""

# Powers the in-app AI ordering chat (POST /api/chat). Without this set, the
# chat widget shows a friendly "not set up yet" message but the rest of the
# app works normally. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=""

# VAPID keypair for web push (order status + admin broadcast notifications).
# Generate with `npx web-push generate-vapid-keys`. VAPID_SUBJECT must be a
# mailto: or https: URL push services can contact you at.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Powers admin's "Generate with AI" menu item icon — searches Pexels for a
# real, free-to-use stock photo of the dish first (lib/generateIcon.js),
# falling back to AI image generation only if this isn't set or Pexels has
# no good match. Get a free key at https://www.pexels.com/api (no card, no
# approval wait). Pexels' license permits this use with no attribution
# required. Shutterstock and other paid stock sites aren't supported —
# downloading their images without an actual license would infringe
# copyright.
PEXELS_API_KEY=""

# Google OAuth client ID for "Sign in with Google" (create one at
# https://console.cloud.google.com/apis/credentials — OAuth client type "Web
# application"). Without it, POST /api/customer/google returns a clear "not
# configured" error and the frontend's Google button doesn't render. Must
# match frontend/.env.example's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=""

# Google reCAPTCHA v3 secret key (create a v3 site at
# https://www.google.com/recaptcha/admin — score-based, no challenge UI).
# Without it, order creation and customer signup/login skip verification
# entirely (same graceful-absence pattern as the keys above). Must pair with
# frontend/.env.example's VITE_RECAPTCHA_SITE_KEY (same site, different keys).
RECAPTCHA_SECRET_KEY=""

# Optional AES-256-GCM obfuscation of JSON API payloads, on top of HTTPS. When
# "true", the server unwraps requests / wraps responses that carry an
# `X-Encrypted: 1` header (the frontend adds it when its own flag is on);
# clients that don't opt in are unaffected. Multipart uploads and static files
# are never wrapped.
#
# This is obfuscation, NOT confidentiality: the matching key must be shipped to
# the browser (frontend's VITE_PAYLOAD_OBFUSCATION_KEY) where any user can read
# it. It deters casual on-the-wire inspection only. Must be the same 32-byte
# key on both sides. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOAD_OBFUSCATION_ENABLED=false
PAYLOAD_OBFUSCATION_KEY=""

# Zoho CPaaS (ZeptoMail) — sends the "I'm interested" confirmation email.
# Create an Email Agent at https://cpaas.zoho.com and copy its API key. Same
# graceful-absence pattern as the keys above: without ZOHO_API_KEY set, the
# email is skipped (logged, not sent) and the rest of the flow works as usual.
ZOHO_BASE_URL="https://cpaas.zoho.com/v1.1/email"
ZOHO_API_KEY=""

# From address/name for outgoing emails (currently just the interest
# confirmation). MAIL_FROM_ADDRESS must be on a domain verified in the Zoho
# CPaaS Email Agent above.
MAIL_FROM_ADDRESS="noreply@danofunmi.com"
MAIL_FROM_NAME="dánọ́fúnmi"

