generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderSource {
  WEB
  WEB_CHAT
  WHATSAPP
}

enum ReceiptStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?
  googleId     String?  @unique
  // The delivery address most recently used on an order — kept up to date
  // (not write-once, unlike phone) so it pre-fills the next order. No
  // uniqueness constraint, so unlike phone this is always safe to overwrite.
  address      String?
  // A popular landmark near the customer, carried over from a first-taste
  // interest registration (see lib/firstTaste.js) when one exists — never
  // overwritten once set, same as name/phone.
  landmark     String?
  createdAt    DateTime @default(now())

  orders             Order[]
  extraneousRequests ExtraneousRequest[]
}

model Location {
  id           String   @id @default(cuid())
  name         String   @unique
  logisticsFee Decimal  @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

model MenuCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  menuItems  MenuItem[]
  menuGroups MenuGroup[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String   @unique
  categoryId  String
  description String?
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  category   MenuCategory     @relation(fields: [categoryId], references: [id])
  options    MenuItemOption[]
  orderItems OrderItem[]
}

model MenuItemOption {
  id         String  @id @default(cuid())
  menuItemId String
  size       String
  price      Decimal @db.Decimal(10, 2)
  active     Boolean @default(true)

  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  groupItems MenuGroupItem[]

  @@unique([menuItemId, size])
}

// A "combo" menu entry — a bundle of other menu items (by size/option), shown
// in the same browsing list as individual MenuItems, priced as the sum of its
// non-bonus items minus an optional discount. Bought as a whole (one or more
// bundles), not broken apart into its constituent items at order time.
model MenuGroup {
  id            String        @id @default(cuid())
  name          String        @unique
  categoryId    String
  description   String?
  icon          String?
  active        Boolean       @default(true)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   MenuCategory    @relation(fields: [categoryId], references: [id])
  items      MenuGroupItem[]
  orderItems OrderItem[]
}

model MenuGroupItem {
  id               String  @id @default(cuid())
  groupId          String
  menuItemOptionId String
  quantity         Int     @default(1)
  isBonus          Boolean @default(false)

  group          MenuGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  menuItemOption MenuItemOption @relation(fields: [menuItemOptionId], references: [id])
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      Int         @unique
  narration        String      @unique
  customerId       String
  locationId       String
  deliveryAddress  String
  landmark         String?
  subtotal         Decimal     @db.Decimal(10, 2)
  logisticsFee     Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING_PAYMENT)
  // Set every time `status` changes (see routes/orders.js) — distinct from
  // `updatedAt`, which also moves on unrelated edits (rider contact,
  // delivery location) and would otherwise misrepresent those as a status
  // change in the admin orders table.
  statusUpdatedAt  DateTime?
  source           OrderSource @default(WEB)
  notes            String?
  // Set (optionally) alongside the PACKED -> OUT_FOR_DELIVERY status move —
  // whoever's carrying the order, however admin wants to note them (name,
  // phone, both). Free text, never required.
  riderContact     String?
  packedAt         DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  // 'YYYY-MM' — which month's batch this order is processed/delivered in,
  // set at creation from lib/orderSchedule.js's cutoff rule (auto-categorized
  // from the submission date) and editable by admin afterward. See
  // splitGroupId below for why a single checkout can produce more than one
  // Order with different orderMonth values.
  orderMonth       String
  // Set (identically, to the first order's own id) on every Order created
  // from the same checkout when a cart's combo and individual-item lines
  // resolved to different orderMonths and had to be split into separate
  // Orders (own narration/payment/delivery each) — see lib/orderCreation.js.
  // Null for an ordinary, unsplit order.
  splitGroupId     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer Customer         @relation(fields: [customerId], references: [id])
  location Location         @relation(fields: [locationId], references: [id])
  items    OrderItem[]
  receipts PaymentReceipt[]
  feedback Feedback[]

  @@index([orderMonth])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  // Exactly one of (menuItemId + menuItemOptionId) or menuGroupId is set —
  // an individual item line, or a combo/group line bought as a bundle.
  menuItemId       String?
  menuItemOptionId String?
  menuGroupId      String?
  itemName         String
  size             String
  unitPrice        Decimal @db.Decimal(10, 2)
  quantity         Int
  lineTotal        Decimal @db.Decimal(10, 2)
  // For a group line: a snapshot of the bundle's composition (items, bonus
  // items, discount) at order time, so it stays accurate even if the combo
  // is edited or deleted later. Null for individual item lines.
  groupSnapshot    Json?

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem?       @relation(fields: [menuItemId], references: [id])
  menuItemOption MenuItemOption? @relation(fields: [menuItemOptionId], references: [id])
  menuGroup      MenuGroup?      @relation(fields: [menuGroupId], references: [id])
}

model PaymentReceipt {
  id           String        @id @default(cuid())
  orderId      String
  imagePath    String?
  senderName   String?
  senderBank   String?
  submittedVia OrderSource   @default(WEB)
  status       ReceiptStatus @default(PENDING)
  confirmedBy  String?
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Feedback {
  id      String @id @default(cuid())
  // Null for "generic" feedback — submitted from the standalone /feedback
  // link (see routes/publicFeedback.js's POST /general) rather than about a
  // specific delivered order. customerName/location/foodType below are only
  // ever populated on that path — an order-linked feedback row gets those
  // details from `order.customer`/`order.location`/`order.items` instead.
  orderId      String?
  rating       Int
  comment      String?
  customerName String?
  location     String?
  foodType     String?
  // Admin opt-out for the landing page's "what customers say" section —
  // independent of deletedAt, which hides a row everywhere (including the
  // admin list). Defaults true so existing/new feedback stays visible unless
  // an admin explicitly hides it.
  visibleOnLanding Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id            String   @id @default(cuid())
  endpoint      String   @unique
  p256dh        String
  auth          String
  customerPhone String?
  createdAt     DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  costEntries CostEntry[]
}

model CostEntry {
  id          String   @id @default(cuid())
  description String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  incurredOn  DateTime
  createdById String?
  createdAt   DateTime @default(now())

  createdBy AdminUser? @relation(fields: [createdById], references: [id])
}

model WhatsappMessageLog {
  id        String   @id @default(cuid())
  fromPhone String
  direction String
  body      String?
  mediaPath String?
  createdAt DateTime @default(now())
}

// An unexpected error caught somewhere a customer was doing something —
// placing an order, chatting with the AI, or any other unhandled route
// error (see the global error handler in index.js and lib/errorLog.js) —
// logged so admin has somewhere to review them, independent of whether an
// alert email went out for it (see lib/email.js's sendAdminAlertEmail,
// ADMIN_EMAILS). `source` is a short tag ('http', 'chat', ...) for filtering;
// `context` is a free-form JSON blob (request path/method, chat message
// count, etc. — whatever's useful for that source, never customer PII like
// full message bodies).
model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  context   Json?
  createdAt DateTime @default(now())
}

// A customer ask the chat bot can't fulfil itself — an item that's not on the
// menu/quoted, a custom bulk request, or a discount ask on a purchase. Logged
// by the AI chat so admin can follow up manually; `readAt` drives the unread
// counter on the admin "Requests" tab. `orderId` is set once admin has
// turned this request into an actual Order after a follow-up conversation
// (see routes/requests.js's create-order endpoint) — a plain id reference
// rather than a formal relation, same lightweight pattern as
// InterestRegistration.orderId.
model ExtraneousRequest {
  id             String      @id @default(cuid())
  requestType    String
  message        String
  customerName   String?
  customerPhone  String?
  customerId     String?
  orderNarration String?
  orderId        String?
  source         OrderSource @default(WEB_CHAT)
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
}

// A "register my interest" submission from the coming-soon page — someone who
// wants to be contacted when ordering opens. `readAt` drives the unread
// counter on the admin "Interested" tab, mirroring ExtraneousRequest.
// `claimedSlot` is true when this submission actually claimed one of the
// limited "first taste" slots (see LaunchSettings) rather than just joining
// the general waitlist; `landmark` is only collected on a slot claim.
// `shortlisted` is an admin-only pick of who actually makes the final
// first-taste list; `finalEmailSentAt` tracks whether they've been sent the
// "you made the list" email so the admin bulk-send doesn't double-email.
// `orderId` is set once admin has pushed a shortlisted person into the
// standard ordering flow (a free "First Taste" order, see lib/firstTaste.js)
// — a plain id reference rather than a formal relation, same lightweight
// pattern as ExtraneousRequest.orderNarration below.
model InterestRegistration {
  id               String    @id @default(cuid())
  name             String
  email            String
  phone            String
  address          String
  landmark         String?
  excites          String?
  claimedSlot      Boolean   @default(false)
  shortlisted      Boolean   @default(false)
  finalEmailSentAt DateTime?
  orderId          String?   @unique
  readAt           DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
}

// Singleton row (id is always "singleton") holding admin-configurable
// pre-launch settings. Currently just the number of "first taste" slots on
// offer; InterestRegistration rows with claimedSlot = true count against it.
model LaunchSettings {
  id              String   @id @default("singleton")
  firstTasteSlots Int      @default(20)
  updatedAt       DateTime @updatedAt
}
