generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderSource {
  WEB
  WEB_CHAT
  WHATSAPP
}

enum ReceiptStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?
  googleId     String?  @unique
  createdAt    DateTime @default(now())

  orders             Order[]
  extraneousRequests ExtraneousRequest[]
}

model Location {
  id           String   @id @default(cuid())
  name         String   @unique
  logisticsFee Decimal  @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

model MenuCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  menuItems  MenuItem[]
  menuGroups MenuGroup[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String   @unique
  categoryId  String
  description String?
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  category   MenuCategory     @relation(fields: [categoryId], references: [id])
  options    MenuItemOption[]
  orderItems OrderItem[]
}

model MenuItemOption {
  id         String  @id @default(cuid())
  menuItemId String
  size       String
  price      Decimal @db.Decimal(10, 2)
  active     Boolean @default(true)

  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  groupItems MenuGroupItem[]

  @@unique([menuItemId, size])
}

// A "combo" menu entry — a bundle of other menu items (by size/option), shown
// in the same browsing list as individual MenuItems, priced as the sum of its
// non-bonus items minus an optional discount. Bought as a whole (one or more
// bundles), not broken apart into its constituent items at order time.
model MenuGroup {
  id            String        @id @default(cuid())
  name          String        @unique
  categoryId    String
  description   String?
  icon          String?
  active        Boolean       @default(true)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   MenuCategory    @relation(fields: [categoryId], references: [id])
  items      MenuGroupItem[]
  orderItems OrderItem[]
}

model MenuGroupItem {
  id               String  @id @default(cuid())
  groupId          String
  menuItemOptionId String
  quantity         Int     @default(1)
  isBonus          Boolean @default(false)

  group          MenuGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  menuItemOption MenuItemOption @relation(fields: [menuItemOptionId], references: [id])
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      Int         @unique
  narration        String      @unique
  customerId       String
  locationId       String
  deliveryAddress  String
  subtotal         Decimal     @db.Decimal(10, 2)
  logisticsFee     Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING_PAYMENT)
  source           OrderSource @default(WEB)
  notes            String?
  packedAt         DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer Customer         @relation(fields: [customerId], references: [id])
  location Location         @relation(fields: [locationId], references: [id])
  items    OrderItem[]
  receipts PaymentReceipt[]
  feedback Feedback[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  // Exactly one of (menuItemId + menuItemOptionId) or menuGroupId is set —
  // an individual item line, or a combo/group line bought as a bundle.
  menuItemId       String?
  menuItemOptionId String?
  menuGroupId      String?
  itemName         String
  size             String
  unitPrice        Decimal @db.Decimal(10, 2)
  quantity         Int
  lineTotal        Decimal @db.Decimal(10, 2)
  // For a group line: a snapshot of the bundle's composition (items, bonus
  // items, discount) at order time, so it stays accurate even if the combo
  // is edited or deleted later. Null for individual item lines.
  groupSnapshot    Json?

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem?       @relation(fields: [menuItemId], references: [id])
  menuItemOption MenuItemOption? @relation(fields: [menuItemOptionId], references: [id])
  menuGroup      MenuGroup?      @relation(fields: [menuGroupId], references: [id])
}

model PaymentReceipt {
  id           String        @id @default(cuid())
  orderId      String
  imagePath    String?
  senderName   String?
  senderBank   String?
  submittedVia OrderSource   @default(WEB)
  status       ReceiptStatus @default(PENDING)
  confirmedBy  String?
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  orderId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id            String   @id @default(cuid())
  endpoint      String   @unique
  p256dh        String
  auth          String
  customerPhone String?
  createdAt     DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  costEntries CostEntry[]
}

model CostEntry {
  id          String   @id @default(cuid())
  description String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  incurredOn  DateTime
  createdById String?
  createdAt   DateTime @default(now())

  createdBy AdminUser? @relation(fields: [createdById], references: [id])
}

model WhatsappMessageLog {
  id        String   @id @default(cuid())
  fromPhone String
  direction String
  body      String?
  mediaPath String?
  createdAt DateTime @default(now())
}

// A customer ask the chat bot can't fulfil itself — an item that's not on the
// menu/quoted, a custom bulk request, or a discount ask on a purchase. Logged
// by the AI chat so admin can follow up manually; `readAt` drives the unread
// counter on the admin "Requests" tab.
model ExtraneousRequest {
  id             String      @id @default(cuid())
  requestType    String
  message        String
  customerName   String?
  customerPhone  String?
  customerId     String?
  orderNarration String?
  source         OrderSource @default(WEB_CHAT)
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
}
